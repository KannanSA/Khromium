import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "mojom/khromium.mojom" ]
}

source_set("khromium") {
  sources = [
    "decision.cc",
    "decision.h",
    "features.cc",
    "features.h",
    "script_patterns.h",
    "system_prompt.cc",
    "system_prompt.h",
  ]

  deps = [
    ":mojom",
    "//base",
  ]
}
